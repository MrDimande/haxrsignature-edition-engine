# Copiar para .env.local — nunca commitar

# Supabase (mesma conta que haxrsignature.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Evento · Despedida de Solteira · Jessica Muege
EDITION_EVENT_JESSICA_FAREWELL_ID=
EDITION_EVENT_JESSICA_TRADITIONAL_ID=

# WhatsApp noiva (só dígitos)
NEXT_PUBLIC_EDITION_FAREWELL_WHATSAPP=

# WhatsApp anfitriao Stan (so digitos) - vazio = botao oculto
NEXT_PUBLIC_EDITION_STAN_WHATSAPP=

# Resend — emails RSVP e reservas de presente
RESEND_API_KEY=
RESEND_BRAND_DOMAIN=false

# Cron Vercel — lembretes RSVP + export API
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDITION_CRON_SECRET=

# URL pública (produção)
NEXT_PUBLIC_SITE_URL=https://edition.haxrsignature.com

# Control-plane � ponte Edition ? Core (RSVP)
# Production: local s� com flags expl�citas (nunca default silencioso).
# Ausente/inv�lido ? HTTP 503 fail-closed.
HAXR_API_BACKEND=local
HAXR_ALLOW_LOCAL_RSVP=true
# Allowlist Production (obrigat�ria) � slugs activos autorizados
HAXR_LOCAL_RSVP_ALLOWED_SLUGS=jessicakulaya,jessicaesamueltraditionalwedding,jessicachadelingerie,jessicasamuelwedding,stan
# disabled (default) | enabled � canary usa disabled
HAXR_RSVP_NOTIFICATION_MODE=disabled
HAXR_CORE_API_BASE_URL=https://www.haxrsignature.com
# Secret partilhado com o Core � NUNCA NEXT_PUBLIC / NUNCA expor ao browser
HAXR_EDITION_PROXY_SECRET=
# true = se o Core falhar, tenta persist�ncia local (NUNCA activo em Production)
HAXR_PROXY_FALLBACK=false
HAXR_PROXY_TIMEOUT_MS=28000
# Preview-only: optional Vercel Protection Bypass secret (server-only)
# HAXR_CORE_VERCEL_BYPASS_SECRET=

# Event bindings (server-only)
EDITION_EVENT_JESSICA_KULAYA_ID=
EDITION_EVENT_JESSICA_FAREWELL_ID=
EDITION_EVENT_JESSICA_TRADITIONAL_ID=
EDITION_EVENT_JESSICA_WEDDING_ID=
EDITION_EVENT_STAN_ID=